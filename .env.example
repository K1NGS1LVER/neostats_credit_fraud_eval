# NeoStats Credit Risk Intelligence Platform - Environment Configuration

# Primary & Secondary LLM: Groq API Key
# Sign up and get free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Models (Default Active & Non-Deprecated)
GROQ_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_SECONDARY_MODEL=groq/compound-mini

# Tertiary Fallback: Local Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Rate Limiting & Debouncing Configuration
MAX_RPM=30
MAX_TPM=60000
DEBOUNCE_WINDOW_MS=400

# Application Port
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
